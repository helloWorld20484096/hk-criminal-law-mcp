# Copy to .env (which is git-ignored) and fill in.
# Docker Compose reads .env automatically for ${VARIABLE} interpolation.

# ---------------------------------------------------------------------------
# Required for a public deployment
# ---------------------------------------------------------------------------

# A long random secret. Clients use it as a bearer token, and it is the
# password on the OAuth consent page. Generate one with:
#   openssl rand -base64 32
HK_LAW_HTTP_ACCESS_KEY=

# Public one-click mode (read-only, deliberately public): leave the key empty
# and set BOTH of these instead. OAuth is auto-approved; anyone can query.
#   HK_LAW_HTTP_ALLOW_ANONYMOUS=1
#   HK_LAW_HTTP_PUBLIC_URL=https://hk-law.example.com

# The exact public base URL, without /mcp. Setting this enables OAuth
# discovery, which ChatGPT/Claude/Gemini use. Must be https unless localhost.
HK_LAW_HTTP_PUBLIC_URL=https://hk-law.example.com

# ---------------------------------------------------------------------------
# Corpus
# ---------------------------------------------------------------------------

HK_LAW_DB=/data/hk_law.db
HK_LAW_HOME=/data
# 0 = allow query-time live HKLII case access; 1 = strictly local.
# A public multi-user deployment should normally use 1 unless the operator has
# permission for that scale. See docs/data-sources-and-licensing.md.
HK_LAW_LOCAL_ONLY=0

# ---------------------------------------------------------------------------
# HTTP behaviour (defaults shown)
# ---------------------------------------------------------------------------

# HK_LAW_HTTP_RATE_LIMIT=120
# HK_LAW_HTTP_RATE_WINDOW=60
# HK_LAW_HTTP_TRUST_PROXY=1
# HK_LAW_HTTP_ALLOW_ANONYMOUS=0
# Set 1 only for an MCP client that cannot consume SSE responses.
# HK_LAW_HTTP_JSON_RESPONSE=0
# Hidden by default; set 1 only if you want chat clients to trigger DOJ syncs.
# HK_LAW_HTTP_ALLOW_SYNC=0
# Comma-separated. Needed only when running behind a host-rewriting proxy.
# Use host:* too if the proxy forwards an explicit port.
# HK_LAW_HTTP_ALLOWED_HOSTS=hk-law.example.com,hk-law.example.com:*
# HK_LAW_HTTP_ALLOWED_ORIGINS=https://chatgpt.com,https://claude.ai

# Optional semantic atlas mount.
# HK_LAW_SEMANTIC_MAP=/semantic_map/data

# Leave unset unless you are using the permission-gated judgment adapter.
# HK_LAW_CASE_PERMISSION_REF=
# HK_LAW_CASE_CITATIONS=
