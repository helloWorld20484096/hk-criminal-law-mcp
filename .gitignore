*.db-shm
*.db-journal
.cache/

# Secret and credential files (never commit)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
.credentials.json
credentials.json
.netrc
secrets.*

